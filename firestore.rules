rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasAllowedDisplayName() {
      return request.resource.data.displayName is string
        && request.resource.data.displayName != ''
        && (request.resource.data.displayName != 'SneakyOwl'
          || request.auth.uid == 'AXOel5MZ8Yelb5a1bHgFcieT80y2');
    }

    // Shared account profile. BiteTrail preferences and tutorial state are
    // intentionally not stored here.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owns(uid)
        && hasAllowedDisplayName()
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoURL', 'createdAt', 'updatedAt'
        ]);
      allow update: if owns(uid)
        && hasAllowedDisplayName()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // A single Firestore document scopes all BiteTrail collections:
    // tools/bite-trail/{users,followings,places}/...
    match /tools/bite-trail/users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.hasCompletedTutorial is bool
        && request.resource.data.keys().hasOnly([
          'defaultCurrency', 'mapStart', 'hasCompletedTutorial', 'createdAt', 'updatedAt'
        ]);
      allow update: if owns(uid)
        && request.resource.data.hasCompletedTutorial is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'defaultCurrency', 'mapStart', 'hasCompletedTutorial', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Reciprocal relationship changes are coordinated by Flask. The client
    // needs only its own watch-list documents for Profile UI state.
    match /tools/bite-trail/followings/{uid}/relationships/{friendUid} {
      allow read: if owns(uid);
      allow write: if false;
    }

    // Place metadata is global and immutable after creation. Cross-owner
    // place/visit reads are deliberately served by Flask, where relationship
    // filtering and parent-place assembly can be performed safely.
    match /tools/bite-trail/places/{placeId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'locationLabel', 'latitude', 'longitude', 'cuisineGenre',
          'createdAt', 'updatedAt'
        ]);
      allow update, delete: if false;

      match /visits/{visitId} {
        allow read: if false;
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerDisplayName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'ownerDisplayName', 'ratingOutOf10', 'costPerPerson',
            'currency', 'itemsBought', 'comments', 'visitedAt', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
